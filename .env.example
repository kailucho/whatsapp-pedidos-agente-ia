# Copia a .env y completa. Nunca subas .env.
PORT=3000
# Token que TU eliges y pegas en la configuracion del webhook de Meta
VERIFY_TOKEN=cambia-este-token
# "Secreto de la app" de Meta (App settings > Basic). Firma los webhooks.
APP_SECRET=
# Token de acceso y Phone number ID (WhatsApp > API Setup en developers.facebook.com)
WA_TOKEN=
PHONE_NUMBER_ID=
GRAPH_VERSION=v21.0
# Numero del dueño (solo digitos con codigo de pais) que recibe avisos de pedidos
OWNER_WA_ID=
# 1 = no envia nada a Meta, solo imprime. Pon 0 para enviar de verdad.
DRY_RUN=1
# Modelo compatible con OpenAI. Vacio = usa el modelo simulado (sin costo).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DB_PATH=./pedidos.db
